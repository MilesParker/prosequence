/tmp
/out-tsc

# Python bytecode.
__pycache__/
*.py[cod]

# Local secrets: ANTHROPIC_API_KEY etc, loaded by roles/run.py at entry.
.env

# Corpus store: its own nested git repo (Directive 1c). Kept out of the outer
# tree so git never records a gitlink / phantom submodule for it.
/discourse-spaces/

# Stop controls (Directive 1e). The kill file is a runtime signal — not
# committed, and not part of the corpus repo. The guard config
# (prosequence/guard_config.toml) IS committed. Runtime output (token log,
# failed-run corpora, collection reports) lives under prosequence/logs/ and is
# ignored by that directory's own .gitignore, which stays tracked so the path
# exists in a fresh clone — an entry here would hide it.
/STOP

/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

.vscode/*
/dist/
