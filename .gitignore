/tmp
/out-tsc

# Python bytecode.
__pycache__/
*.py[cod]

# Local secrets: ANTHROPIC_API_KEY etc, loaded by roles/run.py at entry.
.env

# Corpus store: its own nested git repo (Directive 1c). Kept out of the outer
# tree so git never records a gitlink / phantom submodule for it.
/discourse-spaces/

# Stop controls (Directive 1e). The token log is runtime spend data, and the
# kill file is a runtime signal — neither is committed, and neither belongs in
# the corpus repo. The guard config (prosequence/guard_config.toml) IS committed.
/logs/
/STOP

/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

.vscode/*